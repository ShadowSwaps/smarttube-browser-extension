{
  "manifest_version": 3,
  "name": "SmartTube Browser",
  "version": "0.4.3",
  "description": "A calmer YouTube player: sponsor skipping, playback controls and a local queue. Free and open-source.",
  "minimum_chrome_version": "120",
  "icons": {"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://sponsor.ajay.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["core.js", "appearance.js"],
    "matches": ["https://www.youtube.com/*"]
  }],
  "action": { "default_title": "SmartTube Browser", "default_popup": "popup.html", "default_icon": {"16":"icons/icon-16.png","32":"icons/icon-32.png"} },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
